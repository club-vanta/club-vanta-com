<style>
  .club {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 52%);
    gap: 50px;
    align-items: center;
    padding: 90px 60px 100px var(--content-start);
    overflow: hidden;
  }

  h2 {
    margin: 0;
    font-size: clamp(44px, 4.6vw, 120px);
    line-height: 0.86;
  }

  h2 span,
  h2 em {
    display: block;
    white-space: nowrap;
  }

  h2 em {
    font-style: normal;
    color: var(--red);
  }

  .lede {
    max-width: 40ch;
    margin: 26px 0 0;
    color: var(--mute);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .carnet {
    padding: 38px 42px 40px;
    border-radius: var(--radius-carnet);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-carnet);
    transform: rotate(-3deg);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding-bottom: 14px;
    border-bottom: 2px solid var(--ink);
  }

  .top img {
    flex: none;
    width: 80px;
    height: 80px;
    filter: invert(1);
  }

  .t {
    margin: 0;
    text-align: right;
  }

  .t b {
    display: block;
    font-size: 50px;
    line-height: 0.9;
  }

  /* Red on paper is below 4.5:1, so the label is set large and bold enough
     to count as large text (3:1). */
  .t span {
    color: var(--red);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  ol {
    display: grid;
    gap: 22px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) 38px;
    gap: var(--space-12);
    align-items: center;
  }

  .n {
    color: var(--red);
    font-size: 76px;
    line-height: 0.8;
  }

  li b {
    display: block;
    font-size: 38px;
    line-height: 0.9;
  }

  small {
    color: var(--mute-ink);
    font-size: 16px;
  }

  .box {
    width: 34px;
    height: 34px;
    border: 2px solid var(--ink);
  }

  /* A real checkbox drawn as the carnet's square. No state is saved: it is
     only the pleasure of ticking it. */
  .box {
    position: relative;
    cursor: pointer;
  }

  /* The input covers the box and some margin around it, so the tap target
     is bigger than the drawn square on the phone. */
  .box input {
    position: absolute;
    inset: -10px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .box:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  /* The tick, in red like a pen stroke, overflows the square a bit. */
  .box svg {
    position: absolute;
    left: 10%;
    bottom: 15%;
    width: 120%;
    height: 120%;
    fill: none;
    stroke: var(--red);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.4) rotate(-12deg);
    transform-origin: 30% 80%;
    transition:
      opacity 160ms var(--ease-out),
      transform 360ms var(--ease-out);
  }

  .box input:checked + svg {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .box svg {
      transition: none;
    }
  }

  /* Same as the label above: large bold text keeps the red readable. */
  .rl {
    display: inline-block;
    margin-top: 6px;
    color: var(--red);
    font-size: 19px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1099.98px) {
    /* Between the mobile layout and a wide screen the two columns do not
       fit: the title goes above the carnet. */
    .club {
      grid-template-columns: minmax(0, 1fr);
    }

    h2 {
      font-size: 64px;
    }

    .carnet {
      max-width: 640px;
    }
  }

  @media (max-width: 899.98px) {
    .club {
      display: block;
      padding: 52px var(--space-16) 60px;
    }

    h2 {
      font-size: 44px;
      line-height: 0.88;
    }

    .lede {
      max-width: none;
      margin: var(--space-16) 0 28px;
      line-height: 1.45;
    }

    .carnet {
      padding: 20px 18px;
      transform: rotate(-2deg);
    }

    .top {
      padding-bottom: 10px;
    }

    .top img {
      width: 44px;
      height: 44px;
    }

    .t b {
      font-size: 28px;
    }

    /* At the mock's 10 px there is no room to grow it to large text, so on
       the phone the label is ink instead of red. */
    .t span {
      color: var(--ink);
      font-size: 10px;
      letter-spacing: 0.18em;
    }

    ol {
      gap: var(--space-12);
      margin-top: 14px;
    }

    li {
      grid-template-columns: 30px minmax(0, 1fr) 24px;
      gap: var(--space-8);
    }

    .n {
      font-size: 44px;
    }

    li b {
      font-size: 22px;
    }

    small {
      display: block;
      margin-top: 3px;
      font-size: 12.5px;
      line-height: 1.3;
    }

    .box {
      width: 22px;
      height: 22px;
    }

    .long {
      display: none;
    }

    /* Same reason: ink text, the red stays in the underline. */
    .rl {
      margin-top: 0;
      color: var(--ink);
      font-size: 12.5px;
      text-decoration-color: var(--red);
      text-decoration-thickness: 2px;
      text-underline-offset: 2px;
    }
  }
</style>
