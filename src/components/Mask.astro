---
interface Props {
  coverUrl: string | null;
  muted: boolean;
}

const { coverUrl, muted } = Astro.props;
---

{coverUrl ? (
  <div class:list={["mask", { muted }]} aria-hidden="true">
    <img
      src={coverUrl}
      alt=""
      referrerpolicy="no-referrer"
      loading="lazy"
      decoding="async"
    />
  </div>
) : (
  <div class="mask logo" aria-hidden="true">
    <img src="/vanta.svg" alt="" />
  </div>
)}

<style>
  /* The cover seen through the logo. vanta-mask.svg is white on transparent,
     so it works as an alpha mask. */
  .mask {
    position: relative;
    width: 460px;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    -webkit-mask-image: url(/vanta-mask.svg);
    mask-image: url(/vanta-mask.svg);
    -webkit-mask-size: cover;
    mask-size: cover;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .mask img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 0;
  }

  .muted img {
    filter: grayscale(1);
  }

  /* Without a cover there is nothing to see through it: just the logo. */
  .logo {
    -webkit-mask-image: none;
    mask-image: none;
  }

  .logo img {
    object-fit: contain;
  }

  @media (max-width: 899.98px) {
    .mask {
      width: 260px;
      margin: 26px auto 0;
    }
  }
</style>
