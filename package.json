{
  "name": "club-vanta-com",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run lint",
    "test": "vitest",
    "test:run": "TZ=UTC vitest run",
    "generate:api": "openapi-typescript https://raw.githubusercontent.com/club-vanta/alter-tracker-backend/refs/heads/main/openapi.json -o src/api/types.ts && prettier --write src/api/types.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
